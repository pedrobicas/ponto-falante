      </bpmndi:BPMNEdge>
      <bpmndi:BPMNEdge id="c10_di" bpmnElement="c10">
        <di:waypoint x="1235" y="155" />
        <di:waypoint x="1235" y="200" />
        <di:waypoint x="1310" y="200" />
        <bpmndi:BPMNLabel><dc:Bounds x="1241" y="178" width="90" height="14" /></bpmndi:BPMNLabel>
      </bpmndi:BPMNEdge>
      <bpmndi:BPMNEdge id="c11_di" bpmnElement="c11">
        <di:waypoint x="1460" y="60" />
        <di:waypoint x="1548" y="60" />
        <di:waypoint x="1548" y="112" />
      </bpmndi:BPMNEdge>
      <bpmndi:BPMNEdge id="c12_di" bpmnElement="c12">
        <di:waypoint x="1460" y="200" />
        <di:waypoint x="1548" y="200" />
        <di:waypoint x="1548" y="148" />
      </bpmndi:BPMNEdge>
      <bpmndi:BPMNShape id="Part_Boletim_di" bpmnElement="Part_Boletim" isHorizontal="true">
        <dc:Bounds x="160" y="340" width="2160" height="520" />
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="B_Inicio_di" bpmnElement="B_Inicio">
        <dc:Bounds x="230" y="572" width="36" height="36" />
        <bpmndi:BPMNLabel><dc:Bounds x="200" y="614" width="96" height="28" /></bpmndi:BPMNLabel>
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="B_Ler_di" bpmnElement="B_Ler">
        <dc:Bounds x="310" y="550" width="150" height="80" />
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="B_GwMvp_di" bpmnElement="B_GwMvp" isMarkerVisible="true">
        <dc:Bounds x="510" y="565" width="50" height="50" />
        <bpmndi:BPMNLabel><dc:Bounds x="415" y="535" width="100" height="28" /></bpmndi:BPMNLabel>
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="B_Desatualizado_di" bpmnElement="B_Desatualizado">
        <dc:Bounds x="610" y="725" width="150" height="80" />
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="B_Validar_di" bpmnElement="B_Validar">
        <dc:Bounds x="610" y="550" width="150" height="80" />
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="B_GwReal_di" bpmnElement="B_GwReal" isMarkerVisible="true">
        <dc:Bounds x="810" y="565" width="50" height="50" />
        <bpmndi:BPMNLabel><dc:Bounds x="715" y="535" width="100" height="28" /></bpmndi:BPMNLabel>
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="B_Estimar_di" bpmnElement="B_Estimar">
        <dc:Bounds x="910" y="420" width="150" height="80" />
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="B_Classificar_di" bpmnElement="B_Classificar">
        <dc:Bounds x="1130" y="420" width="150" height="80" />
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="B_GwDemo_di" bpmnElement="B_GwDemo" isMarkerVisible="true">
        <dc:Bounds x="910" y="625" width="50" height="50" />
        <bpmndi:BPMNLabel><dc:Bounds x="790" y="665" width="110" height="28" /></bpmndi:BPMNLabel>
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="B_Simulado_di" bpmnElement="B_Simulado">
        <dc:Bounds x="1010" y="550" width="150" height="80" />
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="B_Indisponivel_di" bpmnElement="B_Indisponivel">
        <dc:Bounds x="1010" y="660" width="150" height="80" />
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="B_Gerar_di" bpmnElement="B_Gerar">
        <dc:Bounds x="1420" y="550" width="150" height="80" />
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="B_Publicar_di" bpmnElement="B_Publicar">
        <dc:Bounds x="1620" y="550" width="150" height="80" />
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="B_GwPublicou_di" bpmnElement="B_GwPublicou" isMarkerVisible="true">
        <dc:Bounds x="1820" y="565" width="50" height="50" />
        <bpmndi:BPMNLabel><dc:Bounds x="1725" y="535" width="100" height="28" /></bpmndi:BPMNLabel>
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="B_Falha_di" bpmnElement="B_Falha">
        <dc:Bounds x="1920" y="660" width="150" height="80" />
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="B_Auditar_di" bpmnElement="B_Auditar">
        <dc:Bounds x="1920" y="440" width="150" height="80" />
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="B_Fim_di" bpmnElement="B_Fim">
        <dc:Bounds x="2140" y="572" width="36" height="36" />
        <bpmndi:BPMNLabel><dc:Bounds x="2184" y="574" width="120" height="28" /></bpmndi:BPMNLabel>
      </bpmndi:BPMNShape>
      <bpmndi:BPMNEdge id="b1_di" bpmnElement="b1">
        <di:waypoint x="266" y="590" />
        <di:waypoint x="310" y="590" />
      </bpmndi:BPMNEdge>
      <bpmndi:BPMNEdge id="b2_di" bpmnElement="b2">
        <di:waypoint x="460" y="590" />
