      </bpmndi:BPMNEdge>
      <bpmndi:BPMNEdge id="c7_di" bpmnElement="c7">
        <di:waypoint x="950" y="200" />
        <di:waypoint x="1085" y="200" />
        <di:waypoint x="1085" y="170" />
      </bpmndi:BPMNEdge>
      <bpmndi:BPMNEdge id="c8_di" bpmnElement="c8">
        <di:waypoint x="1160" y="130" />
        <di:waypoint x="1210" y="130" />
      </bpmndi:BPMNEdge>
      <bpmndi:BPMNEdge id="c9_di" bpmnElement="c9">
        <di:waypoint x="1235" y="105" />
        <di:waypoint x="1235" y="60" />
        <di:waypoint x="1310" y="60" />
