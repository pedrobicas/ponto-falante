        <di:waypoint x="800" y="60" />
        <bpmndi:BPMNLabel><dc:Bounds x="731" y="38" width="90" height="14" /></bpmndi:BPMNLabel>
      </bpmndi:BPMNEdge>
      <bpmndi:BPMNEdge id="c5_di" bpmnElement="c5">
        <di:waypoint x="725" y="155" />
