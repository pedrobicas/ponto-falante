        <di:waypoint x="800" y="200" />
        <bpmndi:BPMNLabel><dc:Bounds x="731" y="178" width="90" height="14" /></bpmndi:BPMNLabel>
      </bpmndi:BPMNEdge>
      <bpmndi:BPMNEdge id="c6_di" bpmnElement="c6">
        <di:waypoint x="950" y="60" />
