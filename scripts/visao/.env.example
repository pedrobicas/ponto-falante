# Copie para .env.local (ignorado pelo Git). Tudo e opcional.
# Chave entre o Render e o servico de visao. Vazia: usa a GENAI_API_KEY de scripts/genai/.env.local,
# que o backend tambem usa quando PF_VISAO_SERVICO_CHAVE nao esta configurada no Render.
PF_VISAO_SERVICO_CHAVE=
# Python de um ambiente ja pronto (padrao: .venv-visao na raiz do repositorio).
VISAO_PYTHON=
# auto (padrao), 1 ou 0
PF_VISAO_GPU=auto
