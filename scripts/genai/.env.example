# Copie para .env.local (ignorado pelo Git) e preencha localmente.
# A mesma chave deve ser usada no header X-API-Key pelo Spring Boot.
GENAI_API_KEY=
GENAI_AUTH_DESATIVADA=0
GENAI_TIMEOUT_S=40
GENAI_PUBLIC_URL=
CF_TUNNEL_NAME=
# Opcional: caminho absoluto do config.yml de um tunel nomeado ja criado.
CF_TUNNEL_CONFIG=
# Opcional: Python do ambiente com genai/requirements.txt instalado.
GENAI_PYTHON=
PF_MODO=agente
# Mesmo modelo medido no teste final v3 (agente_v1 com 7b). O 3b recusa demais.
PF_MODELO=qwen2.5:7b
# Para validar a v3 localmente: PF_MODO=v3 e PF_MODELO_GERADOR=qwen2.5:7b.
# O modo publicado deve ser escolhido depois da avaliacao, nao apenas do build.
# PF_MODELO_GERADOR=qwen2.5:7b
# PF_LIMIAR_V3=-2.5
# OLLAMA_HOST e fixado pelo iniciar.ps1 em 127.0.0.1:11434.
# Site publicado que recebe o endereco do Quick Tunnel (registrar-tunel.ps1).
MVP_PUBLICO_URL=https://ponto-falante.onrender.com
