# Copie para .env.local (ignorado pelo Git) e preencha localmente.
# A mesma chave deve ser usada no header X-API-Key pelo Spring Boot.
GENAI_API_KEY=
GENAI_AUTH_DESATIVADA=0
GENAI_TIMEOUT_S=40
GENAI_PUBLIC_URL=
CF_TUNNEL_NAME=
# Opcional: caminho absoluto do config.yml de um tunel nomeado ja criado.
CF_TUNNEL_CONFIG=
# Opcional: Python do ambiente com genai/requirements.txt instalado.
GENAI_PYTHON=
PF_MODO=agente
# OLLAMA_HOST e fixado pelo iniciar.ps1 em 127.0.0.1:11434.
