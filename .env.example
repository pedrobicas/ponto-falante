# Copie para .env e preencha. O arquivo .env NUNCA vai para o Git.
# Gere valores aleatórios, por exemplo: python -c "import secrets; print(secrets.token_urlsafe(32))"

POSTGRES_PASSWORD=
PF_SALT=

# Token gratuito da API Olho Vivo (sptrans.com.br/desenvolvedores). Vazio = modo demonstração.
SPTRANS_TOKEN=

# Serviço GenAI (FastAPI + Ollama no PC com GPU, exposto pelo Cloudflare Tunnel)
GENAI_URL=http://host.docker.internal:8001
GENAI_API_KEY=

# Chaves de integração (cada consumidor recebe a sua)
RPA_API_KEY=
VISAO_API_KEY=
DISPOSITIVO_API_KEY=
DADOS_API_KEY=
