# Copie para .env e preencha. O arquivo .env NUNCA vai para o Git.
# Gere valores aleatórios, por exemplo: python -c "import secrets; print(secrets.token_urlsafe(32))"

POSTGRES_PASSWORD=
PF_SALT=

# Token gratuito da API Olho Vivo (sptrans.com.br/desenvolvedores). Vazio = modo demonstração.
SPTRANS_TOKEN=
SPTRANS_BASE_URL=https://api.olhovivo.sptrans.com.br/v2.1
# Alternativa oficial: gateway da Prefeitura (apilib.prefeitura.sp.gov.br/store), aplicação inscrita na API OlhoVivo v2.1.
# Consumer Key e Consumer Secret; quando preenchidos, o Spring usa OAuth2 no gateway em vez do login direto.
SPTRANS_GATEWAY_CHAVE=
SPTRANS_GATEWAY_SEGREDO=
# demo preserva a chave no arquivo, mas nao faz chamadas SPTrans na aplicacao.
PF_SPTRANS_MODO=demo

# Serviço GenAI (FastAPI + Ollama no PC com GPU, exposto pelo Cloudflare Tunnel)
GENAI_URL=http://host.docker.internal:8001
GENAI_API_KEY=

# Chaves de integração (cada consumidor recebe a sua)
RPA_API_KEY=
VISAO_API_KEY=
DISPOSITIVO_API_KEY=
DADOS_API_KEY=
